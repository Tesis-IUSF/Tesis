# ============================================================
# CONFIGURACIÓN GENERAL Y PERFIL ACTIVO
# ============================================================
# Define el perfil activo por defecto para desarrollo local
spring.profiles.active=dev
spring.application.name=sitio-web


# ============================================================
# DATOS DE LA INSTITUCIÓN (constancias en PDF)
# ============================================================
app.institucion.nombre=C.E.N. Lcda. Roraima Asansa Escandela
app.institucion.nombre-completo=COMPLEJO EDUCATIVO NACIONAL LCDA. RORAIMA ASANSA ESCANDELA
app.institucion.codigo-plantel=OD34942317
app.institucion.rif=J508197682
app.institucion.municipio=San Francisco
app.institucion.estado=Zulia
app.institucion.direccion=Km 9,5 Vía Perijá, Urbanización Villa Chinita, Av. 1 Parroquia José Domingo Rus
app.institucion.correo=ceroraimasansaescandela@gmail.com
app.institucion.telefono=0424-6772242
app.institucion.director.nombre=MgS. Javier Mavares
app.institucion.director.cedula=V-17.835.835
app.institucion.director.cargo=Director




# ============================================================
# SERVIDOR (Configuración común)
# ============================================================
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true

# ============================================================
# SERIALIZACIÓN Y FORMATO JSON (Jackson)
# ============================================================
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=UTC
spring.jackson.default-property-inclusion=non_null

# ============================================================
# MONITOREO (Actuator)
# ============================================================
management.endpoints.web.base-path=/actuator
management.endpoints.web.exposure.include=health,info,metrics