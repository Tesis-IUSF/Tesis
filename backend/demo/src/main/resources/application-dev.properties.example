# ============================================================
# PERFIL DE DESARROLLO (MySQL Local + Lectura de .env)
# ============================================================
server.port=8080
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=2MB
app.uploads.dir=${UPLOADS_DIR:./uploads}
app.institucion.nombre=${INSTITUCION_NOMBRE:C.E.N. Lcda. Roraima Asansa Escandela}
app.institucion.director=${INSTITUCION_DIRECTOR:}
app.institucion.rif=${INSTITUCION_RIF:}
app.institucion.codigo=${INSTITUCION_CODIGO:}
app.institucion.direccion=${INSTITUCION_DIRECCION:}
app.institucion.telefono=${INSTITUCION_TELEFONO:}
app.institucion.correo=${INSTITUCION_CORREO:}

# Variables de Base de Datos (Toma valores del .env o usa fallbacks)
db.host=${DB_HOST:localhost}
db.port=${DB_PORT:3307}
db.name=${DB_NAME:mi_app_dev}
db.user=${DB_USER:admin}
db.pass=${DB_PASS:dev_password_cambiar}

# Configuración de Conexión MySQL
spring.datasource.url=jdbc:mysql://${db.host}:${db.port}/${db.name}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${db.user}
spring.datasource.password=${db.pass}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Seguridad y Autenticación
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration=86400000
jwt.refreshExpiration=604800000
app.setup.initial-admin-token=${INITIAL_ADMIN_SETUP_TOKEN:}

# Logging detallado para depurar
logging.level.root=INFO
logging.level.com.tuempresa=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE